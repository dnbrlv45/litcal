datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ─── USERS ────────────────────────────────────────────────────────────────────
// Shadow record of the Clerk user. Created/upserted lazily on first API call.
// Clerk owns identity (name, email, avatar, sessions).
// Supabase owns all application data.

model User {
  id        String   @id // Clerk userId — used directly as PK
  email     String   @unique
  firstName String?
  lastName  String?
  timeZone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events              Event[]
  calendarConnections UserCalendarConnection[]
  cases               Case[]
  workspaceMemberships WorkspaceMember[]
}

// ─── WORKSPACES / TEAMS ──────────────────────────────────────────────────────
// First-party LitCal teams. Clerk owns sign-in only; LitCal owns team membership.

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   WorkspaceMember[]
  cases     Case[]
  events    Event[]

  @@index([createdBy])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

// ─── CALENDAR CONNECTIONS ─────────────────────────────────────────────────────
// One row per OAuth provider per user.
// Replaces: googleRefreshToken, googleConnectedAt, googleLitCalId in Clerk metadata.

model UserCalendarConnection {
  id                 String           @id @default(cuid())
  userId             String
  provider           CalendarProvider

  refreshToken       String           // store encrypted in production
  providerCalendarId String?          // Google: the dedicated LitCal calendar ID

  connectedAt        DateTime         @default(now())
  disconnectedAt     DateTime?
  isActive           Boolean          @default(true)
  updatedAt          DateTime         @updatedAt

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
  APPLE
}

// ─── EVENTS ───────────────────────────────────────────────────────────────────
// Source of truth for all calendar events.
// Replaces: litcalEvents[] JSON array in Clerk metadata.

model Event {
  id          String      @id @default(cuid())
  userId      String

  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  timeZone    String      @default("UTC")
  allDay      Boolean     @default(false)

  orgId       String?     // Clerk org ID — null for personal events
  workspaceId String?
  caseId      String?

  eventType   EventType   @default(OTHER)
  status      EventStatus @default(SCHEDULED)
  location    String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  caseRef     Case?               @relation(fields: [caseId], references: [id], onDelete: SetNull)
  googleSync  GoogleCalendarSync?

  @@index([userId, startTime])
  @@index([userId, startTime, endTime])
  @@index([workspaceId, startTime])
  @@index([orgId, startTime])
  @@index([caseId])
}

enum EventType {
  DEADLINE    // filing deadline, response due, statute of limitations
  HEARING     // court hearing, oral argument
  DEPOSITION  // witness or party deposition
  TRIAL       // trial dates and sessions
  CONFERENCE  // status conference, scheduling conference
  MEETING     // client meeting, co-counsel meeting
  REMINDER
  OTHER
}

enum EventStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  RESCHEDULED
}

// ─── GOOGLE CALENDAR SYNC ─────────────────────────────────────────────────────
// Tracks the sync state between a LitCal Event and its Google Calendar copy.
// 1:1 with Event. Cascade-deleted when the Event is deleted.

model GoogleCalendarSync {
  id               String     @id @default(cuid())
  eventId          String     @unique

  googleEventId    String
  googleCalendarId String

  syncedAt         DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  syncStatus       SyncStatus @default(SYNCED)
  lastError        String?

  event            Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([googleEventId])
}

enum SyncStatus {
  SYNCED
  PENDING
  FAILED
  DELETED
}

// ─── CASES ────────────────────────────────────────────────────────────────────

model Case {
  id           String     @id @default(cuid())
  orgId        String?
  workspaceId  String?
  userId       String

  caseNumber   String?
  title        String
  description  String?
  status       CaseStatus @default(ACTIVE)
  caseType     CaseType   @default(CIVIL)

  court        String?
  judge        String?
  jurisdiction String?

  filingDate   DateTime?
  closedDate   DateTime?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  parties      CaseParty[]
  events       Event[]

  @@index([orgId])
  @@index([workspaceId])
  @@index([userId])
  @@index([status])
}

enum CaseStatus {
  ACTIVE
  CLOSED
  ARCHIVED
  PENDING
}

enum CaseType {
  CIVIL
  CRIMINAL
  FAMILY
  BANKRUPTCY
  IMMIGRATION
  ADMINISTRATIVE
  OTHER
}

enum PartyRole {
  PLAINTIFF
  DEFENDANT
  PETITIONER
  RESPONDENT
  COUNTERCLAIMANT
  THIRD_PARTY
  OTHER
}

model CaseParty {
  id      String    @id @default(cuid())
  caseId  String
  name    String
  role    PartyRole
  email   String?
  phone   String?

  caseRef Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}


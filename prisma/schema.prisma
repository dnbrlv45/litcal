datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ─── USERS ────────────────────────────────────────────────────────────────────
// LitCal user account. Google OAuth owns identity proof; LitCal owns sessions/data.
// Supabase owns all application data.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  googleSub    String?  @unique
  microsoftSub String?  @unique
  firstName    String?
  lastName     String?
  timeZone     String   @default("UTC")
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events              Event[]
  calendarConnections UserCalendarConnection[]
  cases               Case[]
  workspaceMemberships WorkspaceMember[]
  sessions            AuthSession[]
  notifications       Notification[]
  notificationPreference UserNotificationPreference?
  emailNotificationLogs  EmailNotificationLog[]

  caseStaffAssignments CaseStaff[]
  assignedEvents       Event[]    @relation("EventAttorney")
  courtRuleRequests    CourtRuleRequest[]
  caseTimeline         CaseTimeline[]
  createdDiscovery     DiscoveryItem[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── WORKSPACES / TEAMS ──────────────────────────────────────────────────────
// First-party LitCal teams. LitCal owns team membership.

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members              WorkspaceMember[]
  invitations          WorkspaceInvitation[]
  cases                Case[]
  events               Event[]
  tasks                Task[]
  notifications        Notification[]
  generatedDeadlines   GeneratedDeadline[]
  courtCoverageAlerts  CourtCoverageAlert[]
  courtRuleRequests    CourtRuleRequest[]
  caseTimeline         CaseTimeline[]
  discoveryItems       DiscoveryItem[]

  @@index([createdBy])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  jobTitle    JobTitle?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskAssignees TaskAssignee[]

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  invitedBy   String
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([email])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum JobTitle {
  ATTORNEY
  PARALEGAL
  ASSISTANT
  STAFF
}

// ─── CALENDAR CONNECTIONS ─────────────────────────────────────────────────────
// One row per OAuth provider per user.
// Replaces the previous Google Calendar token metadata store.

model UserCalendarConnection {
  id                 String           @id @default(cuid())
  userId             String
  provider           CalendarProvider

  refreshToken       String           // store encrypted in production
  providerCalendarId String?          // Google: the dedicated LitCal calendar ID

  gmailRefreshToken  String?          // Google: separate Gmail send-only grant
  gmailConnectedAt   DateTime?

  connectedAt        DateTime         @default(now())
  disconnectedAt     DateTime?
  isActive           Boolean          @default(true)
  updatedAt          DateTime         @updatedAt

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
  APPLE
}

// ─── EVENTS ───────────────────────────────────────────────────────────────────
// Source of truth for all calendar events.
// Replaces the previous JSON event metadata store.

model Event {
  id          String      @id @default(cuid())
  userId      String

  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  timeZone    String      @default("UTC")
  allDay      Boolean     @default(false)

  orgId       String?     // Legacy organization ID; retained for old rows only.
  workspaceId String?
  caseId      String?
  assignedAttorneyId String?
  departmentId String?

  eventType     EventType   @default(OTHER)
  subtype       String?     // hearing subtype label: "CMC", "MSC", "OSC", "Motion Hearing", etc.
  subtypeReason String?     // OSC reason, e.g. "Proof of Service"
  status        EventStatus @default(SCHEDULED)
  location      String?
  department    String?     // free-text fallback; departmentId is preferred when set

  // Remote appearance fields (populated from CourtHearingRule at creation)
  inPerson              Boolean  @default(false)
  courtRuleUnmatched    Boolean  @default(false)
  courtHearingRuleId    String?
  appearanceType      String?
  remoteLink          String?
  phoneNumber         String?
  bridge              String?
  remotePassword        String?
  requestRequired       Boolean?
  requestContactEmail   String?
  requestNotes          String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  caseRef          Case?               @relation(fields: [caseId], references: [id], onDelete: SetNull)
  assignedAttorney User?               @relation("EventAttorney", fields: [assignedAttorneyId], references: [id], onDelete: SetNull)
  departmentRef    Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  googleSync         GoogleCalendarSync?
  tasks              Task[]
  reminders          EventReminder[]
  notifications      Notification[]
  triggeredDeadlines GeneratedDeadline[] @relation("TriggerEvent")
  generatedDeadline  GeneratedDeadline?  @relation("GeneratedEvent")
  discoveryLinked    DiscoveryItem?      @relation("DiscoveryLinkedEvent")

  @@index([userId, startTime])
  @@index([userId, startTime, endTime])
  @@index([workspaceId, startTime])
  @@index([orgId, startTime])
  @@index([caseId])
  @@index([assignedAttorneyId])
  @@index([assignedAttorneyId, startTime, endTime])
  @@index([departmentId])
  @@index([courtHearingRuleId])
}

enum EventType {
  DEADLINE                   // filing deadline, response due, statute of limitations
  HEARING                    // court hearing, oral argument
  DEPOSITION                 // witness or party deposition
  TRIAL                      // trial dates and sessions
  CONFERENCE                 // status conference, scheduling conference
  MEETING                    // client meeting, co-counsel meeting
  MEDIATION                  // mediation session
  COURT_CALL                 // telephonic court appearance
  CASE_MANAGEMENT_CONFERENCE // CMC requiring CMS filing
  REMINDER
  OTHER
}

enum EventStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  RESCHEDULED
}

// ─── GOOGLE CALENDAR SYNC ─────────────────────────────────────────────────────
// Tracks the sync state between a LitCal Event and its Google Calendar copy.
// 1:1 with Event. Cascade-deleted when the Event is deleted.

model GoogleCalendarSync {
  id               String     @id @default(cuid())
  eventId          String     @unique

  googleEventId    String
  googleCalendarId String

  syncedAt         DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  syncStatus       SyncStatus @default(SYNCED)
  lastError        String?

  event            Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([googleEventId])
}

enum SyncStatus {
  SYNCED
  PENDING
  FAILED
  DELETED
}

// ─── COUNTIES & COURTS ───────────────────────────────────────────────────────

model County {
  id     String  @id @default(cuid())
  state  String  @default("CA")
  name   String
  courts Court[]
  cases  Case[]

  @@unique([state, name])
}

model Court {
  id          String       @id @default(cuid())
  name        String
  countyId    String
  county      County       @relation(fields: [countyId], references: [id], onDelete: Cascade)
  cases       Case[]
  departments Department[]

  @@unique([countyId, name])
  @@index([countyId])
}

model Department {
  id               String             @id @default(cuid())
  name             String             // "10A", "285", "18b", etc.
  courtId          String
  court            Court              @relation(fields: [courtId], references: [id], onDelete: Cascade)
  events           Event[]
  courtHearingRules CourtHearingRule[]

  @@unique([courtId, name])
  @@index([courtId])
}

// ─── CASES ────────────────────────────────────────────────────────────────────

model Case {
  id           String     @id @default(cuid())
  orgId        String?
  workspaceId  String?
  userId       String

  caseNumber   String?
  title        String
  description  String?
  status       CaseStatus @default(ACTIVE)
  caseType     CaseType   @default(AUTO_ACCIDENT)

  court        String?
  judge        String?
  county       String?
  countyId     String?
  courtId      String?

  defendant       String?
  defenseFirm     String?
  defenseAttorney String?

  filingDate   DateTime?
  closedDate   DateTime?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  countyRef County?    @relation(fields: [countyId], references: [id], onDelete: SetNull)
  courtRef  Court?     @relation(fields: [courtId], references: [id], onDelete: SetNull)
  staff     CaseStaff[]
  parties   CaseParty[]
  events    Event[]
  tasks     Task[]
  notifications  Notification[]
  timeline       CaseTimeline[]
  discoveryItems DiscoveryItem[]

  @@index([orgId])
  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([countyId])
  @@index([courtId])
}

enum CaseStatus {
  ACTIVE
  CLOSED
  ARCHIVED
  PENDING
}

enum CaseType {
  AUTO_ACCIDENT
  SLIP_AND_FALL
  GOVERNMENT_CLAIM
  DOG_BITE
  PREMISES_LIABILITY
  MEDICAL_MALPRACTICE
  WRONGFUL_DEATH
  PRODUCT_LIABILITY
  OTHER
}

enum CaseStaffRole {
  ATTORNEY
  PARALEGAL
  ASSISTANT
}

model CaseStaff {
  id        String        @id @default(cuid())
  caseId    String
  userId    String
  role      CaseStaffRole
  createdAt DateTime      @default(now())

  caseRef   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId, role])
  @@index([caseId])
  @@index([userId])
}

enum PartyRole {
  PLAINTIFF
  DEFENDANT
  PETITIONER
  RESPONDENT
  COUNTERCLAIMANT
  THIRD_PARTY
  OTHER
}

model CaseParty {
  id      String    @id @default(cuid())
  caseId  String
  name    String
  role    PartyRole
  email   String?
  phone   String?

  caseRef Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// ─── TASKS ───────────────────────────────────────────────────────────────────

model Task {
  id              String       @id @default(cuid())
  workspaceId     String
  caseId          String?
  eventId         String?
  isAutoGenerated Boolean      @default(false)

  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?

  googleEventId    String?
  googleCalendarId String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  caseRef           Case?              @relation(fields: [caseId],  references: [id], onDelete: SetNull)
  eventRef          Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  assignees         TaskAssignee[]
  notifications     Notification[]
  generatedDeadline GeneratedDeadline?
  discoveryLinked   DiscoveryItem?     @relation("DiscoveryLinkedTask")

  @@index([workspaceId])
  @@index([caseId])
  @@index([eventId])
  @@index([status])
  @@index([dueDate])
}

model TaskAssignee {
  taskId   String
  memberId String

  task   Task            @relation(fields: [taskId],   references: [id], onDelete: Cascade)
  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([taskId, memberId])
  @@index([memberId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── EVENT REMINDERS ─────────────────────────────────────────────────────────

model EventReminder {
  id            String   @id @default(cuid())
  eventId       String
  minutesBefore Int
  sendAt        DateTime // business-day adjusted
  sent          Boolean  @default(false)
  createdAt     DateTime @default(now())

  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([sendAt, sent])
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id          String           @id @default(cuid())
  userId      String
  workspaceId String
  type        NotificationType
  title       String
  body        String?
  read        Boolean          @default(false)
  taskId      String?
  eventId     String?
  caseId      String?
  createdAt   DateTime         @default(now())

  user      User       @relation(fields: [userId],      references: [id], onDelete: Cascade)
  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskRef   Task?      @relation(fields: [taskId],      references: [id], onDelete: SetNull)
  eventRef  Event?     @relation(fields: [eventId],     references: [id], onDelete: SetNull)
  caseRef   Case?      @relation(fields: [caseId],      references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([workspaceId])
  @@index([taskId])
}

enum NotificationType {
  TASK_ASSIGNED
  CASE_ASSIGNED
  EVENT_REMINDER
}

model UserNotificationPreference {
  id                              String   @id @default(cuid())
  userId                          String   @unique
  taskAssignedEmails              Boolean  @default(true)
  taskDueEmails                   Boolean  @default(true)
  eventReminderEmails             Boolean  @default(true)
  deadlineReminderEmails          Boolean  @default(true)
  discoveryReminderEmails         Boolean  @default(true)
  remoteAppearanceReminderEmails  Boolean  @default(true)
  ruleApprovalEmails              Boolean  @default(true)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailNotificationLog {
  id                String    @id @default(cuid())
  userId            String
  workspaceId       String?
  emailType         String
  relatedEntityType String
  relatedEntityId   String
  reminderKey       String
  recipientEmail    String
  subject           String
  status            String
  sentAt            DateTime?
  error             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, emailType, relatedEntityType, relatedEntityId, reminderKey])
  @@index([userId])
  @@index([workspaceId])
  @@index([emailType])
  @@index([status])
  @@index([sentAt])
}

// ─── DEADLINE AUTOMATION ─────────────────────────────────────────────────────
// Tracks every deadline event / task that was auto-generated from a trigger event.
// @@unique([triggerEventId, ruleKey]) is the primary dedup guard.

model GeneratedDeadline {
  id               String   @id @default(cuid())
  workspaceId      String
  triggerEventId   String
  ruleKey          String   // e.g. "TRIAL_EXPERT_DESIGNATION"
  generatedEventId String?  @unique
  generatedTaskId  String?  @unique
  userModified     Boolean  @default(false)
  createdAt        DateTime @default(now())

  workspace      Workspace @relation(fields: [workspaceId],      references: [id], onDelete: Cascade)
  triggerEvent   Event     @relation("TriggerEvent",             fields: [triggerEventId],   references: [id], onDelete: Cascade)
  generatedEvent Event?    @relation("GeneratedEvent",           fields: [generatedEventId], references: [id], onDelete: SetNull)
  generatedTask  Task?     @relation(fields: [generatedTaskId],  references: [id], onDelete: SetNull)

  @@unique([triggerEventId, ruleKey])
  @@index([workspaceId])
  @@index([triggerEventId])
  @@index([generatedEventId])
  @@index([generatedTaskId])
}

// ─── COURT HEARING RULES ──────────────────────────────────────────────────────
// Imported from the Court Hearings CSV. Supports county-wide, court-wide, and
// department-level rules. Deduped on (countyName, courtName, department).

model CourtHearingRule {
  id             String      @id @default(cuid())
  state          String      @default("CA")
  countyId       String?
  courtId        String?
  departmentId   String?
  countyName     String
  courtName      String?
  department     String?     // raw string, e.g. "10A" — preserved for matching
  appearanceType String?
  phoneNumber    String?
  bridge         String?
  password       String?
  remoteLink            String?
  requestRequired       Boolean  @default(false)
  requestContactEmail   String?  // email to send request to (instead of a direct join link)
  requestNotes          String?  // e.g. "File via portal, max 5 days before hearing"
  requestDaysBefore     Int?     // how many days before the event to file; defaults to 7
  active                Boolean  @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  departmentRef  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([state, countyName, courtName, department])
  @@index([state, countyName])
  @@index([countyId])
  @@index([courtId])
  @@index([departmentId])
}

// ─── COURT COVERAGE ALERTS ────────────────────────────────────────────────────
// Created when an event is created for a county/dept with no matching rule.
// Deduped per (county, court, department, alertType) while unresolved.

enum AlertType {
  COUNTY
  DEPARTMENT
}

model CourtCoverageAlert {
  id                   String    @id @default(cuid())
  alertType            AlertType
  state                String    @default("CA")
  county               String
  court                String    @default("")
  department           String    @default("")
  firstSeenAt          DateTime  @default(now())
  createdByWorkspaceId String
  resolved             Boolean   @default(false)
  resolvedAt           DateTime?

  workspace            Workspace @relation(fields: [createdByWorkspaceId], references: [id])

  @@index([resolved])
  @@index([state, county, court, department, alertType, resolved])
}

// ─── COURT RULE REQUESTS ──────────────────────────────────────────────────────
// Submitted by workspace users when a court isn't covered yet.
// Super admin reviews and creates the actual CourtHearingRule.

model CourtRuleRequest {
  id                   String    @id @default(cuid())
  state                String    @default("CA")
  county               String
  court                String?
  department           String?
  appearanceType       String?
  remoteLink           String?
  phoneNumber          String?
  bridge               String?
  password             String?
  requestRequired      Boolean   @default(false)
  requestContactEmail  String?
  notes                String?
  requestedById        String
  workspaceId          String
  reviewed             Boolean   @default(false)
  accepted             Boolean   @default(false)
  reviewedAt           DateTime?
  createdAt            DateTime  @default(now())

  requestedBy  User      @relation(fields: [requestedById], references: [id])
  workspace    Workspace @relation(fields: [workspaceId], references: [id])

  @@index([reviewed])
  @@index([workspaceId])
}

// ─── DISCOVERY ───────────────────────────────────────────────────────────────

enum DiscoveryType {
  FORM_INTERROGATORIES
  SPECIAL_INTERROGATORIES
  REQUESTS_FOR_PRODUCTION
  REQUESTS_FOR_ADMISSION
  SUPPLEMENTAL_FORM_INTERROGATORIES
  SUPPLEMENTAL_SPECIAL_INTERROGATORIES
  SUPPLEMENTAL_REQUESTS_FOR_PRODUCTION
  SUPPLEMENTAL_REQUESTS_FOR_ADMISSION
  DEPOSITION_NOTICE
  OTHER
}

enum DiscoveryDirection {
  RECEIVED
  SERVED
}

enum DiscoveryStatus {
  AWAITING_RESPONSE
  RESPONSES_RECEIVED
  EXTENSION_GRANTED
  OVERDUE
  COMPLETED
}

enum ExtensionAppliesTo {
  OUR_DEADLINE
  OPPOSING_DEADLINE
  BOTH
}

model DiscoveryItem {
  id                   String             @id @default(cuid())
  caseId               String
  workspaceId          String
  createdBy            String

  discoveryType        DiscoveryType
  direction            DiscoveryDirection

  servedOrReceivedDate DateTime
  originalDueDate      DateTime
  currentDueDate       DateTime

  status               DiscoveryStatus    @default(AWAITING_RESPONSE)
  notes                String?

  linkedEventId        String?            @unique
  linkedTaskId         String?            @unique

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  caseRef              Case               @relation(fields: [caseId],       references: [id], onDelete: Cascade)
  workspace            Workspace          @relation(fields: [workspaceId],  references: [id], onDelete: Cascade)
  creator              User               @relation(fields: [createdBy],    references: [id], onDelete: Cascade)
  linkedEvent          Event?             @relation("DiscoveryLinkedEvent", fields: [linkedEventId], references: [id], onDelete: SetNull)
  linkedTask           Task?              @relation("DiscoveryLinkedTask",  fields: [linkedTaskId],  references: [id], onDelete: SetNull)
  extensions           DiscoveryExtension[]

  @@index([caseId])
  @@index([workspaceId])
  @@index([status])
}

model DiscoveryExtension {
  id                String             @id @default(cuid())
  discoveryItemId   String
  extensionNumber   Int

  grantedDate       DateTime
  previousDueDate   DateTime
  newDueDate        DateTime

  mutual            Boolean            @default(false)
  appliesTo         ExtensionAppliesTo

  notes             String?
  createdBy         String
  createdAt         DateTime           @default(now())

  discoveryItem     DiscoveryItem      @relation(fields: [discoveryItemId], references: [id], onDelete: Cascade)

  @@index([discoveryItemId])
}

// ─── FUTURE ───────────────────────────────────────────────────────────────────
// model InboxItem { ... }
// enum InboxSource { EMAIL DOCUMENT MANUAL }
// enum InboxStatus { UNREAD PROCESSING PROCESSED ARCHIVED }

// ─── CASE TIMELINE ────────────────────────────────────────────────────────────

model CaseTimeline {
  id          String   @id @default(cuid())
  caseId      String
  workspaceId String
  actorUserId String?
  type        String
  title       String
  description String?
  metadata    Json?
  importance  String   @default("NORMAL") // "HIGH" | "NORMAL" | "LOW"
  createdAt   DateTime @default(now())

  caseRef   Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([workspaceId])
}

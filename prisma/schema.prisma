datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ─── USERS ────────────────────────────────────────────────────────────────────
// Shadow record of the Clerk user. Created/upserted lazily on first API call.
// Clerk owns identity (name, email, avatar, sessions).
// Supabase owns all application data.

model User {
  id        String   @id // Clerk userId — used directly as PK
  email     String   @unique
  firstName String?
  lastName  String?
  timeZone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events              Event[]
  calendarConnections UserCalendarConnection[]
}

// ─── CALENDAR CONNECTIONS ─────────────────────────────────────────────────────
// One row per OAuth provider per user.
// Replaces: googleRefreshToken, googleConnectedAt, googleLitCalId in Clerk metadata.

model UserCalendarConnection {
  id                 String           @id @default(cuid())
  userId             String
  provider           CalendarProvider

  refreshToken       String           // store encrypted in production
  providerCalendarId String?          // Google: the dedicated LitCal calendar ID

  connectedAt        DateTime         @default(now())
  disconnectedAt     DateTime?
  isActive           Boolean          @default(true)
  updatedAt          DateTime         @updatedAt

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
  APPLE
}

// ─── EVENTS ───────────────────────────────────────────────────────────────────
// Source of truth for all calendar events.
// Replaces: litcalEvents[] JSON array in Clerk metadata.

model Event {
  id          String      @id @default(cuid())
  userId      String

  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  timeZone    String      @default("UTC")
  allDay      Boolean     @default(false)

  eventType   EventType   @default(OTHER)
  status      EventStatus @default(SCHEDULED)
  location    String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleSync  GoogleCalendarSync?

  @@index([userId, startTime])
  @@index([userId, startTime, endTime])
}

enum EventType {
  DEADLINE    // filing deadline, response due, statute of limitations
  HEARING     // court hearing, oral argument
  DEPOSITION  // witness or party deposition
  TRIAL       // trial dates and sessions
  CONFERENCE  // status conference, scheduling conference
  MEETING     // client meeting, co-counsel meeting
  REMINDER
  OTHER
}

enum EventStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  RESCHEDULED
}

// ─── GOOGLE CALENDAR SYNC ─────────────────────────────────────────────────────
// Tracks the sync state between a LitCal Event and its Google Calendar copy.
// 1:1 with Event. Cascade-deleted when the Event is deleted.

model GoogleCalendarSync {
  id               String     @id @default(cuid())
  eventId          String     @unique

  googleEventId    String
  googleCalendarId String

  syncedAt         DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  syncStatus       SyncStatus @default(SYNCED)
  lastError        String?

  event            Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([googleEventId])
}

enum SyncStatus {
  SYNCED
  PENDING
  FAILED
  DELETED
}


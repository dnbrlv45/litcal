datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ─── USERS ────────────────────────────────────────────────────────────────────
// LitCal user account. Google OAuth owns identity proof; LitCal owns sessions/data.
// Supabase owns all application data.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  googleSub    String?  @unique
  microsoftSub String?  @unique
  firstName    String?
  lastName  String?
  timeZone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events              Event[]
  calendarConnections UserCalendarConnection[]
  cases               Case[]
  workspaceMemberships WorkspaceMember[]
  sessions            AuthSession[]
  notifications       Notification[]

  caseStaffAssignments CaseStaff[]
  assignedEvents       Event[] @relation("EventAttorney")
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── WORKSPACES / TEAMS ──────────────────────────────────────────────────────
// First-party LitCal teams. LitCal owns team membership.

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            WorkspaceMember[]
  invitations        WorkspaceInvitation[]
  cases              Case[]
  events             Event[]
  tasks              Task[]
  notifications      Notification[]
  generatedDeadlines GeneratedDeadline[]

  @@index([createdBy])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  jobTitle    JobTitle?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskAssignees TaskAssignee[]

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  invitedBy   String
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([email])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum JobTitle {
  ATTORNEY
  PARALEGAL
  ASSISTANT
  STAFF
}

// ─── CALENDAR CONNECTIONS ─────────────────────────────────────────────────────
// One row per OAuth provider per user.
// Replaces the previous Google Calendar token metadata store.

model UserCalendarConnection {
  id                 String           @id @default(cuid())
  userId             String
  provider           CalendarProvider

  refreshToken       String           // store encrypted in production
  providerCalendarId String?          // Google: the dedicated LitCal calendar ID

  gmailRefreshToken  String?          // Google: separate Gmail send-only grant
  gmailConnectedAt   DateTime?

  connectedAt        DateTime         @default(now())
  disconnectedAt     DateTime?
  isActive           Boolean          @default(true)
  updatedAt          DateTime         @updatedAt

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
  APPLE
}

// ─── EVENTS ───────────────────────────────────────────────────────────────────
// Source of truth for all calendar events.
// Replaces the previous JSON event metadata store.

model Event {
  id          String      @id @default(cuid())
  userId      String

  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  timeZone    String      @default("UTC")
  allDay      Boolean     @default(false)

  orgId       String?     // Legacy organization ID; retained for old rows only.
  workspaceId String?
  caseId      String?
  assignedAttorneyId String?
  departmentId String?

  eventType   EventType   @default(OTHER)
  status      EventStatus @default(SCHEDULED)
  location    String?
  department  String?     // free-text fallback; departmentId is preferred when set

  // Remote appearance fields (populated from CourtHearingRule at creation)
  inPerson            Boolean  @default(false)
  courtHearingRuleId  String?
  appearanceType      String?
  remoteLink          String?
  phoneNumber         String?
  bridge              String?
  remotePassword        String?
  requestRequired       Boolean?
  requestContactEmail   String?
  requestNotes          String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  caseRef          Case?               @relation(fields: [caseId], references: [id], onDelete: SetNull)
  assignedAttorney User?               @relation("EventAttorney", fields: [assignedAttorneyId], references: [id], onDelete: SetNull)
  departmentRef    Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  googleSync         GoogleCalendarSync?
  tasks              Task[]
  reminders          EventReminder[]
  notifications      Notification[]
  triggeredDeadlines GeneratedDeadline[] @relation("TriggerEvent")
  generatedDeadline  GeneratedDeadline?  @relation("GeneratedEvent")

  @@index([userId, startTime])
  @@index([userId, startTime, endTime])
  @@index([workspaceId, startTime])
  @@index([orgId, startTime])
  @@index([caseId])
  @@index([assignedAttorneyId])
  @@index([assignedAttorneyId, startTime, endTime])
  @@index([departmentId])
  @@index([courtHearingRuleId])
}

enum EventType {
  DEADLINE                   // filing deadline, response due, statute of limitations
  HEARING                    // court hearing, oral argument
  DEPOSITION                 // witness or party deposition
  TRIAL                      // trial dates and sessions
  CONFERENCE                 // status conference, scheduling conference
  MEETING                    // client meeting, co-counsel meeting
  MEDIATION                  // mediation session
  COURT_CALL                 // telephonic court appearance
  CASE_MANAGEMENT_CONFERENCE // CMC requiring CMS filing
  REMINDER
  OTHER
}

enum EventStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  RESCHEDULED
}

// ─── GOOGLE CALENDAR SYNC ─────────────────────────────────────────────────────
// Tracks the sync state between a LitCal Event and its Google Calendar copy.
// 1:1 with Event. Cascade-deleted when the Event is deleted.

model GoogleCalendarSync {
  id               String     @id @default(cuid())
  eventId          String     @unique

  googleEventId    String
  googleCalendarId String

  syncedAt         DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  syncStatus       SyncStatus @default(SYNCED)
  lastError        String?

  event            Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([googleEventId])
}

enum SyncStatus {
  SYNCED
  PENDING
  FAILED
  DELETED
}

// ─── COUNTIES & COURTS ───────────────────────────────────────────────────────

model County {
  id     String  @id @default(cuid())
  name   String  @unique
  courts Court[]
  cases  Case[]
}

model Court {
  id          String       @id @default(cuid())
  name        String
  countyId    String
  county      County       @relation(fields: [countyId], references: [id], onDelete: Cascade)
  cases       Case[]
  departments Department[]

  @@unique([countyId, name])
  @@index([countyId])
}

model Department {
  id               String             @id @default(cuid())
  name             String             // "10A", "285", "18b", etc.
  courtId          String
  court            Court              @relation(fields: [courtId], references: [id], onDelete: Cascade)
  events           Event[]
  courtHearingRules CourtHearingRule[]

  @@unique([courtId, name])
  @@index([courtId])
}

// ─── CASES ────────────────────────────────────────────────────────────────────

model Case {
  id           String     @id @default(cuid())
  orgId        String?
  workspaceId  String?
  userId       String

  caseNumber   String?
  title        String
  description  String?
  status       CaseStatus @default(ACTIVE)
  caseType     CaseType   @default(AUTO_ACCIDENT)

  court        String?
  judge        String?
  county       String?
  countyId     String?
  courtId      String?

  defendant       String?
  defenseFirm     String?
  defenseAttorney String?

  filingDate   DateTime?
  closedDate   DateTime?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  countyRef County?    @relation(fields: [countyId], references: [id], onDelete: SetNull)
  courtRef  Court?     @relation(fields: [courtId], references: [id], onDelete: SetNull)
  staff     CaseStaff[]
  parties   CaseParty[]
  events    Event[]
  tasks     Task[]
  notifications Notification[]

  @@index([orgId])
  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([countyId])
  @@index([courtId])
}

enum CaseStatus {
  ACTIVE
  CLOSED
  ARCHIVED
  PENDING
}

enum CaseType {
  AUTO_ACCIDENT
  SLIP_AND_FALL
  GOVERNMENT_CLAIM
  DOG_BITE
  PREMISES_LIABILITY
  MEDICAL_MALPRACTICE
  WRONGFUL_DEATH
  PRODUCT_LIABILITY
  OTHER
}

enum CaseStaffRole {
  ATTORNEY
  PARALEGAL
  ASSISTANT
}

model CaseStaff {
  id        String        @id @default(cuid())
  caseId    String
  userId    String
  role      CaseStaffRole
  createdAt DateTime      @default(now())

  caseRef   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId, role])
  @@index([caseId])
  @@index([userId])
}

enum PartyRole {
  PLAINTIFF
  DEFENDANT
  PETITIONER
  RESPONDENT
  COUNTERCLAIMANT
  THIRD_PARTY
  OTHER
}

model CaseParty {
  id      String    @id @default(cuid())
  caseId  String
  name    String
  role    PartyRole
  email   String?
  phone   String?

  caseRef Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// ─── TASKS ───────────────────────────────────────────────────────────────────

model Task {
  id              String       @id @default(cuid())
  workspaceId     String
  caseId          String?
  eventId         String?
  isAutoGenerated Boolean      @default(false)

  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  caseRef           Case?              @relation(fields: [caseId],  references: [id], onDelete: SetNull)
  eventRef          Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  assignees         TaskAssignee[]
  notifications     Notification[]
  generatedDeadline GeneratedDeadline?

  @@index([workspaceId])
  @@index([caseId])
  @@index([eventId])
  @@index([status])
  @@index([dueDate])
}

model TaskAssignee {
  taskId   String
  memberId String

  task   Task            @relation(fields: [taskId],   references: [id], onDelete: Cascade)
  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([taskId, memberId])
  @@index([memberId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── EVENT REMINDERS ─────────────────────────────────────────────────────────

model EventReminder {
  id            String   @id @default(cuid())
  eventId       String
  minutesBefore Int
  sendAt        DateTime // business-day adjusted
  sent          Boolean  @default(false)
  createdAt     DateTime @default(now())

  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([sendAt, sent])
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id          String           @id @default(cuid())
  userId      String
  workspaceId String
  type        NotificationType
  title       String
  body        String?
  read        Boolean          @default(false)
  taskId      String?
  eventId     String?
  caseId      String?
  createdAt   DateTime         @default(now())

  user      User       @relation(fields: [userId],      references: [id], onDelete: Cascade)
  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskRef   Task?      @relation(fields: [taskId],      references: [id], onDelete: SetNull)
  eventRef  Event?     @relation(fields: [eventId],     references: [id], onDelete: SetNull)
  caseRef   Case?      @relation(fields: [caseId],      references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([workspaceId])
  @@index([taskId])
}

enum NotificationType {
  TASK_ASSIGNED
  CASE_ASSIGNED
  EVENT_REMINDER
}

// ─── DEADLINE AUTOMATION ─────────────────────────────────────────────────────
// Tracks every deadline event / task that was auto-generated from a trigger event.
// @@unique([triggerEventId, ruleKey]) is the primary dedup guard.

model GeneratedDeadline {
  id               String   @id @default(cuid())
  workspaceId      String
  triggerEventId   String
  ruleKey          String   // e.g. "TRIAL_EXPERT_DESIGNATION"
  generatedEventId String?  @unique
  generatedTaskId  String?  @unique
  userModified     Boolean  @default(false)
  createdAt        DateTime @default(now())

  workspace      Workspace @relation(fields: [workspaceId],      references: [id], onDelete: Cascade)
  triggerEvent   Event     @relation("TriggerEvent",             fields: [triggerEventId],   references: [id], onDelete: Cascade)
  generatedEvent Event?    @relation("GeneratedEvent",           fields: [generatedEventId], references: [id], onDelete: SetNull)
  generatedTask  Task?     @relation(fields: [generatedTaskId],  references: [id], onDelete: SetNull)

  @@unique([triggerEventId, ruleKey])
  @@index([workspaceId])
  @@index([triggerEventId])
  @@index([generatedEventId])
  @@index([generatedTaskId])
}

// ─── COURT HEARING RULES ──────────────────────────────────────────────────────
// Imported from the Court Hearings CSV. Supports county-wide, court-wide, and
// department-level rules. Deduped on (countyName, courtName, department).

model CourtHearingRule {
  id             String      @id @default(cuid())
  countyId       String?
  courtId        String?
  departmentId   String?
  countyName     String
  courtName      String?
  department     String?     // raw string, e.g. "10A" — preserved for matching
  appearanceType String?
  phoneNumber    String?
  bridge         String?
  password       String?
  remoteLink            String?
  requestRequired       Boolean  @default(false)
  requestContactEmail   String?  // email to send request to (instead of a direct join link)
  requestNotes          String?  // e.g. "File via portal, max 5 days before hearing"
  requestDaysBefore     Int?     // how many days before the event to file; defaults to 7
  active                Boolean  @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  departmentRef  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([countyName, courtName, department])
  @@index([countyName])
  @@index([countyId])
  @@index([courtId])
  @@index([departmentId])
}

